{
    "name": "umltranslator-datamodel",
    "version": "1.0.0",
    "description": "Datamodel used for reverse code source & source code generation in multiple languages",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "build": "esbuild src/index.ts --bundle --minify --outfile=dist/index.js --platform=node --target=es2020",
        "postbuild": "npm run types",
        "types": "dts-bundle-generator -o dist/index.d.ts src/index.ts",
        "lint:check": "eslint .",
        "lint:write": "eslint . --fix",
        "format:write": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --coverage --config vitest.config.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ThalesGroup/lumber.git"
    },
    "keywords": [
        "plantuml",
        "puml"
    ],
    "author": "Valentin COLOMER",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/ThalesGroup/lumber/issues"
    },
    "homepage": "https://github.com/ThalesGroup/lumber#readme",
    "devDependencies": {
        "@types/node": "^25.5.2",
        "@vitest/coverage-v8": "^4.1.2",
        "dts-bundle-generator": "^9.5.1",
        "esbuild": "^0.28.0",
        "eslint": "^10.1.0",
        "prettier": "^3.8.1",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2"
    }
}
